# sub2api 中转站（OpenAI 兼容协议）
SUB2API_BASE_URL=https://your-sub2api-site.example.com
CODEX_API_KEY=sk-xxx
GEMINI_API_KEY=sk-xxx

# 站点实际暴露的模型名（用 scripts/probe_sub2api.py 自动发现）
PLANNER_MODEL=codex
IMAGE_MODEL=gemini

# mock = 占位图离线模式; sub2api = 真模型
PROVIDER_MODE=mock

# 可选
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db
# PUBLIC_BASE_URL=http://127.0.0.1:8000

# === M2/M3 ===
# 认证：jwt=强制登录；dev=本地调试免登录
AUTH_MODE=jwt
JWT_SECRET=change-me-to-a-long-random-string
# Google OAuth（配置后 /auth/google 自动启用）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe（配置后充值自动启用）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
